# Normalize line endings: store text files as LF and check them out as LF,
# so clones on any platform are byte-identical and Git stops warning about
# LF -> CRLF conversions.
* text=auto eol=lf

# Windows scripts keep CRLF so they run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be normalized.
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
